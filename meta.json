{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam-labs:capture-control-webapp",
  "visibility": "public",
  "url": "https://github.com/viam-labs/capture-control-webapp",
  "description": "Web app for recording labeled robot demonstration episodes with the capture-control sensor",
  "models": [
    {
      "api": "rdk:service:generic",
      "model": "viam-labs:capture-control:webapp"
    }
  ],
  "applications": [
    {
      "name": "capture-control-webapp",
      "type": "single_machine",
      "entrypoint": "dist/index.html"
    }
  ],
  "entrypoint": "bin/capture-control-webapp",
  "first_run": "",
  "build": {
    "build": "./build.sh",
    "setup": "./setup.sh",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64",
      "windows/amd64"
    ]
  }
}
